{
  "name": "client-extension",
   "protocols": [
    "ws",
    "sse",
    "lp"
  ],
  "repetitions": 5,
  "warmupSeconds": 5,
  "cooldownSeconds": 5,
  "clockSyncSamples": 20,
  "defaults": {
    "clientQueueCapacity": 4096,
    "messageBufferSize": 4096,
    "longPollMaxBatch": 100
  },
  "scenarios": [
    {
      "name": "clients-1000",
      "clients": 1000,
      "payloadSize": 1024,
      "rate": 500,
      "durationSeconds": 30
    },
    {
      "name": "clients-2000",
      "clients": 2000,
      "payloadSize": 1024,
      "rate": 500,
      "durationSeconds": 30
    },
    {
      "name": "clients-5000",
      "clients": 5000,
      "payloadSize": 1024,
      "rate": 500,
      "durationSeconds": 30
    }
  ]
}
